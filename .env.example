# Copy to .env and change the tokens.

# Storage and input pack
DB_PATH=app.db
PACK_DIR=.

# LLM mode: replay (default, no Ollama needed) | local (Ollama) | stub (tests) | live (not configured)
LLM_MODE=replay
REPLAY_DIR=replay

# Two fixed identities. The role comes only from the token.
ANALYST_TOKEN=change-me-analyst
REVIEWER_TOKEN=change-me-reviewer

# Local model (used when LLM_MODE=local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_MAX_CALLS=450
